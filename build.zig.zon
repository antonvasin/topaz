            .hash = "N-V-__8AAMxVvAIalChC2bXMLXbWpURCkFNzlDy86Nwguncd",
        },
        .sqlite = .{
            .url = "https://www.sqlite.org/2026/sqlite-amalgamation-3530200.zip",
            .hash = "N-V-__8AALc_rgC04POe18O0LKFRm4ouQpLtL3riscEmWp-Q",
        },
        .md4c = .{
            .url = "https://github.com/mity/md4c/archive/refs/tags/release-0.5.3.tar.gz",
            .hash = "N-V-__8AAF-DEADsiGuy83YqbGOj9AVrUnWIMka5RE7AHvK7",
        },
        .yaml = .{
